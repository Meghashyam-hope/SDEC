PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sdec

JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=12h

# No SMS gateway wired up yet — OTPs are logged server-side and echoed
# back in the /auth/login response so the flow is testable locally.
OTP_DEV_MODE=true

CLIENT_ORIGIN=http://localhost:5173

# Single shared admin login — no separate admin user table for this project.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
