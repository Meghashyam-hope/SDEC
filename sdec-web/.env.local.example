# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — never expose to the client. Used for the
# voter roll CSV import, provisioning/resetting voter and officer/admin
# logins (see actions/voters.ts, actions/team.ts), and looking up a
# voter's real email server-side during login.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to link the Supabase CLI to the hosted project for migrations:
#   npx supabase link --project-ref your-project-ref
SUPABASE_PROJECT_REF=your-project-ref

# Optional. The deployed site's canonical URL (e.g. https://sdec.example.edu),
# used for absolute OpenGraph/share metadata. Safe to leave unset locally.
NEXT_PUBLIC_SITE_URL=
