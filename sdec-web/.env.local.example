# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — never expose to the client. Used for the
# voter roll CSV import (see SDEC_PLAN §11.3), looking up a voter's real
# email server-side during login, and the AUTH_DEV_BYPASS code generation.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to link the Supabase CLI to the hosted project for migrations:
#   npx supabase link --project-ref your-project-ref
SUPABASE_PROJECT_REF=your-project-ref

# Set to true to skip sending real OTP emails (no SMTP configured yet — see
# CLAUDE.md). The code is generated via the Admin API and shown in the UI
# instead of emailed. Set to false (or unset) once real SMTP is live.
AUTH_DEV_BYPASS=true

# Optional. The deployed site's canonical URL (e.g. https://sdec.example.edu),
# used for absolute OpenGraph/share metadata. Safe to leave unset locally.
NEXT_PUBLIC_SITE_URL=
